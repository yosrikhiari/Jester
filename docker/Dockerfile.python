# Build the Go ingestion worker into a static binary so the scheduled cycle
# can run ingest without the Go toolchain present (offline, fast). Lives
# outside the bind-mounted /app so the runtime mount does not hide it.
FROM golang:latest AS gobuild
WORKDIR /src
COPY go/go.mod go/go.sum ./
RUN go mod download
COPY go/ ./
RUN CGO_ENABLED=0 go build -o /out/worker ./cmd/worker

# Python operator console + CLI runtime.
# Code is bind-mounted from the repo at runtime (.:/app), so edits need no rebuild.
# Only the pip dependencies are baked in here.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/python \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install dependencies once at build time (static requirements file).
# The repo's requirements.txt ships with Windows-1252 comments (the `§`
# section markers), which pip can't decode as UTF-8. Re-encode to UTF-8
# first so the build is reproducible on any host.
COPY python/requirements.txt /tmp/requirements.txt
RUN python -c "open('/tmp/requirements.utf8.txt','w',encoding='utf-8').write(open('/tmp/requirements.txt',encoding='cp1252',errors='replace').read())" \
    && pip install -r /tmp/requirements.utf8.txt

# `cron` so the Schedule tab can register a real job inside the container.
RUN apt-get update \
    && apt-get install -y --no-install-recommends cron \
    && rm -rf /var/lib/apt/lists/*

# Prebuilt Go worker binary (resolvable as `worker` on PATH); lets the cron
# cycle run ingest without a Go toolchain in this image.
COPY --from=gobuild /out/worker /usr/local/bin/worker

# Entrypoint starts the cron daemon, then launches the console.
COPY docker/entrypoint.console.sh /usr/local/bin/console-entrypoint.sh
RUN chmod +x /usr/local/bin/console-entrypoint.sh

# Default launch: the operator console (serves the static UI + /api).
# Override with `docker compose run jester-console python -m jester.cli ...`.
EXPOSE 8619
ENTRYPOINT ["/usr/local/bin/console-entrypoint.sh"]
CMD ["--host", "0.0.0.0", "--port", "8619", "--db", "/app/data/jester.db", "--config", "/app/config"]
