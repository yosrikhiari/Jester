# Build the Go ingestion worker into a static binary so the scheduled cycle
# can run ingest without the Go toolchain present (offline, fast). Lives
# outside the bind-mounted /app so the runtime mount does not hide it.
#
# F-07: golang:latest is a moving target — whatever upstream pushes the
# morning of a build. go/go.mod declares `go 1.26`, so `1.26` is the newest
# tag the code supports (the tag extends to the newest patch release, fed
# by the module checksums); go.Dockerfile carries the same pin so the two
# images cannot quietly build against different toolchains. Pinned
# 2026-10-29 through the Docker Hub registry HTTP API, digest verified
# against the registry's Docker-Content-Digest header.
FROM golang:1.26@sha256:670bb5aa5349ae03b8516764718486f4f16399134bdc9acd0c46a23f043ab05c AS gobuild
WORKDIR /src
COPY go/go.mod go/go.sum ./
RUN go mod download
COPY go/ ./
RUN CGO_ENABLED=0 go build -o /out/worker ./cmd/worker

# Python operator console + CLI runtime.
# Code is bind-mounted from the repo at runtime (.:/app), so edits need no rebuild.
# Only the pip dependencies are baked in here.
#
# F-07: the base carries a digest like everything else in this repo that is
# installed from the network (2026-10-29, registry API, same method as the
# golang pin) — a retagged python:3.12-slim changed bytes nobody decided on.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

# PYTHONDONTWRITEBYTECODE: a non-root user cannot write `__pycache__` into the
# bind-mounted /app, which is root-owned on the host. Without it every import
# of the console's own code is re-parsed and logs nothing useful; with it, no
# bytecode is expected in the first place.
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/python \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/jester

WORKDIR /app

# Install from the PEP 751 lock, not the requirements file: pinned versions
# and a sha256 per wheel, so a rebuild installs the bytes that were tested
# rather than whatever is newest that morning.
#
# `--only-binary :all:` refuses to fall back to a source distribution, which
# is what stops `pip install` executing an arbitrary setup.py at build time.
# Every entry in the lock is already a wheel, so nothing legitimate is lost.
#
# This also retires a workaround: requirements.txt used to carry Windows-1252
# section markers that pip could not decode, and the build re-encoded the file
# before installing. The file is plain ASCII now and the lock is generated, so
# the dance goes.
#
# `pip lock` output needs pip 25.1+, and the slim image's pip can lag, so it
# is upgraded first rather than failing with a parse error about TOML.
COPY python/pylock.toml /tmp/pylock.toml
# pip itself is pinned and binary-only for the same reason everything else
# is: it is a dependency being installed from the network at build time, and
# "latest" is not a version anyone chose. Bump it deliberately.
RUN pip install --no-cache-dir -q --only-binary :all: "pip==26.2.1" \
    && pip install --no-cache-dir --only-binary :all: -r /tmp/pylock.toml

# WHY THIS CONTAINER DROPS ROOT (V3-25). It used to install `cron` and run as
# root so the Schedule tab could write crontabs inside the container. That made
# the container a second, silent scheduler: the host's task scheduler already
# registers the jobs (config/schedule.yaml), and two schedulers racing one
# SQLite file is the failure the compose header documents. So cron is gone from
# this image, and with it the only reason to be root.
#
# The uid is fixed at 10001 rather than "whatever useradd picks" so a volume
# written by one build stays writable by the next. /app/data is created and
# chowned HERE, before USER: Docker copies a mount point's ownership into a
# fresh named volume, so the `jester_docker_data` volume starts owned by 10001
# and the console can write the archive. A volume created by an older root
# image keeps root ownership — the entrypoint says so plainly rather than
# failing with "unable to open database file".
RUN groupadd --gid 10001 jester \
    && useradd --uid 10001 --gid 10001 --no-log-init \
       --home-dir /home/jester --create-home --shell /usr/sbin/nologin jester \
    && mkdir -p /app/data \
    && chown -R jester:jester /app/data /home/jester

# Prebuilt Go worker binary (resolvable as `worker` on PATH); lets a scheduled
# ingest run without a Go toolchain in this image. The HOST scheduler runs it
# through `docker compose exec`; this container no longer schedules anything.
COPY --from=gobuild /out/worker /usr/local/bin/worker

# Launch the console. The entrypoint is a plain `exec python -m jester.console`
# now: the cron daemon it used to start is gone with the package.
COPY docker/entrypoint.console.sh /usr/local/bin/console-entrypoint.sh
RUN chmod +x /usr/local/bin/console-entrypoint.sh

# Default launch: the operator console (serves the static UI + /api).
# Override with `docker compose run jester-console python -m jester.cli ...`.
EXPOSE 8619
# Everything above this line runs as root at BUILD time, which is what lets
# pip install into the image and the uid be fixed. From here the container is
# uid 10001 for its whole life, including the healthcheck.
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/console-entrypoint.sh"]
# jester-docker.db, NOT jester.db, and the name is the whole point.
#
# Vectors are namespaced by the database file's STEM (see collection_for), so
# every database called jester.db anywhere on earth shares one Qdrant
# collection. This stack's archive is a throwaway in its own volume, but it was
# pointed at the host's `nuggets__jester` — 105,471 points at 768 dimensions
# from real runs — while producing 32-dimension fake vectors. The console
# reported "collection is 768-dim but fake produces 32", which was true.
#
# compose says this stack "never touches the host's". That was true of SQLite
# and false of vectors until this line.
CMD ["--host", "0.0.0.0", "--port", "8619", "--db", "/app/data/jester-docker.db", "--config", "/app/config"]
