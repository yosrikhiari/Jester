# Jester environment. Copy to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# `.env` is gitignored — never commit it. Rotate any key that has been pasted
# into a chat, a ticket, or a log.
#
# WHO READS THIS FILE
#   - python/jester/env.py loads it into os.environ before anything else runs.
#     It searches `.env`, then `config/local.env`, then `local.env`, and the
#     first hit wins. Values already exported in your shell OUTRANK the file:
#     a deliberate one-off override should not lose to a dotfile.
#   - docker-compose.yml passes it to the console and worker via `env_file`.
#
# Every variable below is optional. The listed default is what the code uses
# when the variable is unset — none of them has to be present for the stack to
# boot, and only the ones you actually want to change need uncommenting.


# ─── CloakBrowser: live fetch through the stealth browser ──────────────────
# Only the Reddit and YouTube adapters use this. Hacker News and Discourse
# talk to documented public JSON APIs and need none of it.
#
# The container runs without a licence key (free tier), which caps you at ONE
# concurrent session — the worker opens sources one at a time for that reason.
CLOAKBROWSER_LICENSE_KEY=

# Residential proxy, as a full URL. Empty means traffic exits from this
# machine's own IP, which is fine at the volumes config/thresholds.yaml sets
# but draws more challenges. Datacenter IPs get flagged on reputation alone,
# independent of how good the browser fingerprint is.
CLOAKBROWSER_PROXY=

# BOOLEAN (true/false), and it only does anything when CLOAKBROWSER_PROXY is
# also set: it asks cloakserve to derive timezone, locale and WebRTC IP from
# the proxy's exit. A country code here (the old "us") parses as FALSE, i.e.
# silently off — which is why config/scraper.yaml leaves timezone and locale
# blank rather than hardcoding a region the exit IP disagrees with.
CLOAKBROWSER_GEOIP=


# ─── LLM providers ─────────────────────────────────────────────────────────
# Which provider each agent uses is set in config/thresholds.yaml
# (extractor_provider, synthesizer_provider, critic_provider), not here. This
# file only carries the credentials those choices need.

# Groq — OpenAI-compatible chat completions. Needed when any *_provider is
# set to `groq`, which config/thresholds.yaml currently does for the
# synthesizer and the critic.
GROQ_API_KEY=

# Override only to pin a region or route through a proxy. Default: Groq's
# public API endpoint.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama — read by the ollama SDK itself, not by Jester. Needed when a
# *_provider is set to `ollama`. Default: http://127.0.0.1:11434
# The `live` compose profile publishes one on 11434.
# OLLAMA_HOST=http://127.0.0.1:11434


# ─── GitHub ────────────────────────────────────────────────────────────────
# OPTIONAL and free. A personal access token with NO SCOPES SELECTED — it
# authenticates the rate limit, not any permission, and can read nothing your
# anonymous requests could not already read.
#
# Without it: 60 core requests/hour and 10 searches/minute. Each issue costs
# two core requests plus one search per repo, so ten configured repos at
# depth 3 exhaust the hourly budget in a single run. With it: 5,000/hour.
#
# Create at https://github.com/settings/tokens (classic, no scopes ticked).
GITHUB_TOKEN=


# ─── Stack Exchange ────────────────────────────────────────────────────────
# Entirely OPTIONAL and free — no account approval, no cost, no card.
#
# Without a key the API allows 300 requests/day per IP. Each question costs
# two requests (the question, then its answers) plus one listing per site per
# run, so six configured sites at depth 3 exhaust that well before the day is
# out. A key raises the ceiling to 10,000/day and the source stops being a
# rationing exercise.
#
# Register at https://stackapps.com/apps/oauth/register — the "key" field,
# not the client secret. The worker reports quota_remaining after every run
# either way, so you can see where you stand.
STACKEXCHANGE_KEY=


# ─── Worker ────────────────────────────────────────────────────────────────
# 1 = the Go worker loads fixtures instead of fetching the live web, and the
# Python pipeline may seed the canned corpus when the queue is empty. Anything
# else means live. docker-compose.yml sets this to 1 so a plain
# `docker compose up` runs fully offline.
#
# Leave it UNSET for real scraping. A scheduled cycle inherits the shell it
# was registered from, so a stray 1 here is a schedule that fetches nothing.
JESTER_MOCK=1

# How to run the Go worker, tried in this order:
#   GO_BIN             path to the `go` toolchain (uses `go run ./cmd/worker`)
#   JESTER_WORKER_BIN  path to a prebuilt `worker` binary — this is what the
#                      Docker image sets, so the scheduled cycle runs without
#                      the Go toolchain installed
# Unset: `worker` on PATH, then `go` on PATH, then a vendored Windows go.exe.
# GO_BIN=
# JESTER_WORKER_BIN=


# ─── Storage ───────────────────────────────────────────────────────────────
# SQLite database. The Go worker and the Python pipeline MUST see the same
# file — that handoff queue is the cross-process contract.
# Default: data/jester.db
# JESTER_DB=data/jester.db

# Shared Qdrant server for embeddings. Unset means a per-database local path
# instead, which is fine for one process but not for a console and a worker
# running at once. The compose stack sets http://qdrant:6333.
# JESTER_QDRANT_URL=http://127.0.0.1:6333


# ─── Run bookkeeping ───────────────────────────────────────────────────────
# Filed against every run so scheduled work is distinguishable from work you
# triggered by hand — the rolling duration baseline keys off it, and blending
# the two populations makes it meaningless. The generated scheduler launcher
# sets `scheduled`; the console sets `manual`. Default: manual
# JESTER_ORIGIN=manual

# Command run when a nightly/scheduled run fails, as a plain argv string.
# Supports {exit_code}, {run_id} and {reason} placeholders. Unset = no
# notification is attempted.
# JESTER_NOTIFY_CMD=/usr/local/bin/notify --code {exit_code} --run {run_id}


# ─── Problem-signal archive (the collector, `--profile signals`) ───────────────────
# Where `jester signals load` writes the archive. Defaults match the
# profile-gated `clickhouse` service in docker-compose.yml, so a local run
# needs none of these set. Port 8123 is the HTTP interface, deliberately: the
# loader speaks JSONEachRow over stdlib urllib rather than pulling an SDK in
# for one POST, and 9000 is already taken on this machine by another project.
# CLICKHOUSE_URL=http://127.0.0.1:8123
# CLICKHOUSE_DB=jester
# CLICKHOUSE_USER=jester
# The container reads this too; leave it unset and both sides use `jester`.
# A real deployment sets it here, not in docker-compose.yml, which is
# committed.
# CLICKHOUSE_PASSWORD=


# ─── Tests only ────────────────────────────────────────────────────────────
# Path to a Python-created database, to run the Go side's cross-language
# contract test against it. Unset: that test skips.
# JESTER_CONTRACT_DB=
