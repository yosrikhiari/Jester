# Jester local environment example. Copy to local.env and fill in secrets.
# Do NOT commit local.env.

# --- CloakBrowser (live fetch, M1.1+) ---
# Free tier cap: ONE concurrent session (§36). Do not raise concurrency.
CLOAKBROWSER_LICENSE_KEY=
CLOAKBROWSER_PROXY=
CLOAKBROWSER_GEOIP=

# --- LLM (Python agent pipeline) ---
# NOTE: ANTHROPIC_API_KEY used to be listed here and is read NOWHERE in this
# repo — setting it did nothing. See .env.example at the repo root, which is
# generated from the variables the code actually reads.

# Groq (OpenAI-compatible chat completions). Turn it on with
# llm_provider: groq in thresholds.yaml, or point one role at it with
# synthesizer_provider: groq -- the extractor runs once per comment, so it
# is usually the one you leave local.
GROQ_API_KEY=
# Override only to pin a region or a proxy; the default is Groq's public API.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Worker ---
# Set to 1 to run the Go worker in mock mode (no live fetch).
JESTER_MOCK=1
