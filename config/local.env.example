# Jester local environment example. Copy to local.env and fill in secrets.
# Do NOT commit local.env.

# --- CloakBrowser (live fetch, M1.1+) ---
# Free tier cap: ONE concurrent session (§36). Do not raise concurrency.
CLOAKBROWSER_LICENSE_KEY=
CLOAKBROWSER_PROXY=
CLOAKBROWSER_GEOIP=

# --- LLM (Python agent pipeline) ---
ANTHROPIC_API_KEY=

# --- Worker ---
# Set to 1 to run the Go worker in mock mode (no live fetch).
JESTER_MOCK=1
